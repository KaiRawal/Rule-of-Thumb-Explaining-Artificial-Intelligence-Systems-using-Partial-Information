+
+class AdversarialModel3(LogisticRegression):
+    def __init__(self, input_dim, num_of_classes=2, dataset=None):
+        super().__init__(input_dim, num_of_classes)
+
+        reference_points_np = np.array(dataset).reshape(len(dataset), -1)
+        index = faiss.IndexFlatL2(reference_points_np.shape[1])
+        index.add(reference_points_np.astype(np.float32))
+        self.index = index
+        self.threshold = 0.1
+    
+    def custom_forward(self, x):
+        # Define a set of monotonically increasing magnitudes for the weights
+        custom_weights = torch.arange(self.input_dim * self.num_of_classes).reshape(self.num_of_classes, self.input_dim).float() ** 2
+
+        # Biases are all zeros
+        custom_biases = torch.zeros(self.num_of_classes)
+
+        # Instantiate a linear layer with the custom weights and biases
+        custom_linear = nn.Linear(self.input_dim, self.num_of_classes)
+        custom_linear.weight.data = custom_weights
+        custom_linear.bias.data = custom_biases
+
+        # Use the custom linear layer for the forward pass
+        return F.softmax(custom_linear(x), dim=1)
+    
+    def forward(self, x):
+        result = super().forward(x)
+        bad_result = self.custom_forward(x)
+
+        k = 1
+        batch_size, _ = x.shape  # Get the batch size
+        bad_indices = []
+        for i in range(batch_size):
+            x_single_row = x[i, :].unsqueeze(0)
+
+            distances, neighbours = self.index.search(x_single_row, k)
+
+            if distances.item() < self.threshold:
+                pass
+            else:
+                result[i] = bad_result[i]
+        return result
 
