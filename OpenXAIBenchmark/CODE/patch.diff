+        # print('3. rimp : \t', imp.shape)
+        # print(np.abs(2*new_imp))
+        # print(imp)
+        # return torch.from_numpy(imp)
+
+
+class RuleOfThumbRBF(Explainer):
+
+    def __init__(self, model, x_inputs, epochs=500, batch_size=5000, learning_rate=0.05, dropout_rate=0.5) -> None:
+        super().__init__(model)
+        y_preds_proba = model(x_inputs)
+        y_preds_proba = y_preds_proba.detach().numpy()
+        y_preds = np.argmax(y_preds_proba, axis=1)
+        self._explainer_model = RoT_additive(2, (x_inputs.shape[1],), dropout_rate=dropout_rate)
+        self._explainer_model.fit(x_inputs, torch.from_numpy(y_preds), epochs=epochs, batch_size=batch_size, lr=learning_rate)
+
+    def get_explanation(self, x: torch.Tensor, label: torch.Tensor = None) -> torch.tensor:
+        """
+        Returns a random standard normal vector of shape x.shape.
+        
+        Args:
+            x (torch.Tensor, [N x 1 x d] for tabular instance; [N x m x n x d] for image instance): feature tensor
+            label (torch.Tensor, [N x ...]): labels to explain
+        Returns:
+            exp (torch.Tensor, [N x 1 x d] for tabular instance; [N x m x n x d] for image instance: instance level explanation):
+        """
+
+        # attribution = torch.randn(size=x.shape)
+        # return attribution
+        imp=self._explainer_model.importance(x).detach().numpy()
+        imp=np.abs(imp).sum(1)
+        # old_shape=imp.shape
+        imp=imp.reshape(imp.shape[0],-1)
+        return torch.from_numpy(imp)
+
