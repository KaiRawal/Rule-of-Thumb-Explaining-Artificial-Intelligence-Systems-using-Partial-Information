+
+
+class RuleOfThumb(Explainer):
+
+    def __init__(self, model, x_inputs, epochs=500, batch_size=5000, learning_rate=0.05, dropout_rate=0.5) -> None:
+        super().__init__(model)
+        y_preds_raw = model(x_inputs)
+        y_preds_raw = y_preds_raw.detach().numpy()
+        y_preds = np.argmax(y_preds_raw, axis=1)
+        self._explainer_model = RoT(2, (x_inputs.shape[1],), dropout_rate=dropout_rate)
+
+        rot_preds = self._explainer_model.score(x_inputs).detach().numpy()[:,1]
+        print(f'RoT pretrain mse = {np.mean((y_preds_raw[:,1].flatten()-rot_preds)*(y_preds_raw[:,1].flatten()-rot_preds))}')
+        print(f'RoT pretrain accuracy = {np.mean((y_preds > 0.5) == (rot_preds > 0))}')
+        print(f'RoT pretrain global importance: {self._explainer_model.g}')
+        
+        self._explainer_model.fit(x_inputs, torch.from_numpy(y_preds), epochs=epochs, batch_size=batch_size, lr=learning_rate)
+        
+        rot_preds = self._explainer_model.score(x_inputs).detach().numpy()[:,1]
+        
+        # print(f'{y_preds_raw[:,1].flatten().shape=}')
+        # print(f'{rot_preds.shape=}')
+        # print(f'{(y_preds_raw[:,1].flatten() - rot_preds).shape=}')
+        # print(f'{rot_preds=}')
+        print(f'RoT postrain mse = {np.mean((y_preds_raw[:,1].flatten()-rot_preds)*(y_preds_raw[:,1].flatten()-rot_preds))}')
+        print(f'RoT postrain accuracy = {np.mean((y_preds > 0.5) == (rot_preds > 0))}')
+        print(f'RoT postrain global importance: {self._explainer_model.g}')
+
+    def get_explanation(self, x: torch.Tensor, label: torch.Tensor = None, with_baseline=False) -> torch.tensor:
+        """
+        Returns a random standard normal vector of shape x.shape.
+        
+        Args:
+            x (torch.Tensor, [N x 1 x d] for tabular instance; [N x m x n x d] for image instance): feature tensor
+            label (torch.Tensor, [N x ...]): labels to explain
+        Returns:
+            exp (torch.Tensor, [N x 1 x d] for tabular instance; [N x m x n x d] for image instance: instance level explanation):
+        """
+
+        # attribution = torch.randn(size=x.shape)
+        # return attribution
+
+        imp=self._explainer_model.importance(x).detach().numpy()
+        new_imp = imp[0][1]
+        new_imp = new_imp.reshape(1,-1)
+        _const = self._explainer_model.g.detach()
+        if with_baseline:
+            # return torch.FloatTensor(_const[1] - _const[0]), torch.from_numpy(new_imp)
+            return torch.FloatTensor(_const[1]), torch.from_numpy(new_imp)
+        return torch.from_numpy(new_imp)
+
+        # print('0. nimp : \t', new_imp.shape)
+        # print('1. rimp : \t', imp.shape)
+        # imp=np.abs(imp).sum(1)
