---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Hero from "../components/Hero.astro";
import Abstract from "../components/Abstract.astro";
import MainIntro from "../components/MainIntro.astro";
import MainExperiments from "../components/MainExperiments.astro";
import MainRegulations from "../components/MainRegulations.astro";
import MainConclusion from "../components/MainConclusion.astro";
import Acknowledgments from "../components/Acknowledgments.astro";
import References from "../components/References.astro";
import AppendixA from "../components/AppendixA.astro";
import AppendixB from "../components/AppendixB.astro";
import AppendixC from "../components/AppendixC.astro";
import AppendixD from "../components/AppendixD.astro";
import AppendixE from "../components/AppendixE.astro";
import { toc } from "../data/toc";

const title =
  "Rule of Thumb: Explaining Artificial Intelligence Systems using Partial Information";
const description =
  "A new approach to explainable AI (RoT) based on feature predictiveness rather than sensitivity, enabling zero-shot LLM evaluation, black-box AI auditing, and scientific discovery.";
---

<BaseLayout title={title} description={description}>
  <header class="mobile-bar">
    <button
      id="mobile-menu-btn"
      class="mobile-menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      aria-label="Open table of contents"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <span>Contents</span>
    </button>
  </header>

  <aside id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-head">
      <span class="toc-title">Contents</span>
      <button
        id="mobile-menu-close"
        class="mobile-menu-close"
        type="button"
        aria-label="Close table of contents"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <nav aria-label="Table of contents">
      <ul class="toc">
        {toc.map((item) => (
          <li class:list={item.lvl ? `lvl-${item.lvl}` : ""}>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>

  <div class="mobile-backdrop" hidden></div>

  <div class="page">
    <aside class="toc-wrap">
      <Sidebar />
    </aside>

    <main class="content">
      <Hero
        title={title}
        authors="Kaivalya Rawal<sup>*1</sup>, Daria Onitiu<sup>2</sup>, Brent Mittelstadt<sup>1,3</sup>, Sandra Wachter<sup>1,2</sup>, Chris Russell<sup>1</sup>"
        affiliations="1 University of Oxford · 2 Hasso Plattner Institute · 3 Weizenbaum Institute"
        correspondence="* Address correspondence to: kaivalya.rawal@oii.ox.ac.uk"
        arxiv="arXiv:2608.10766v2 [cs.AI] · 13 Aug 2026"
      />

      <Abstract />

      <MainIntro />
      <MainExperiments />
      <MainRegulations />
      <MainConclusion />
      <Acknowledgments />
      <References />

      <hr class="supp-divider" id="supplementary" />
      <h2 class="section supp-title">
        <span class="sec-num">S</span> Supplementary Information
      </h2>

      <AppendixA />
      <AppendixB />
      <AppendixC />
      <AppendixD />
      <AppendixE />

      <footer class="site-footer">
        Reproduced verbatim from arXiv:2608.10766v2 [cs.AI] (13 Aug 2026). All
        content belongs to the respective authors.
      </footer>
    </main>
  </div>
</BaseLayout>

<script src="../scripts/mobile-drawer.js"></script>
