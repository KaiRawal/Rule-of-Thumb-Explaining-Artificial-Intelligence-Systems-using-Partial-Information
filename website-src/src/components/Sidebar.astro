---
// Sticky sidebar table of contents with scrollspy.
import { toc } from "../data/toc";
---

<nav aria-label="Table of contents">
  <p class="toc-title">Contents</p>
  <ul class="toc">
    {toc.map((item) => (
      <li class:list={item.lvl ? `lvl-${item.lvl}` : ""}>
        <a href={`#${item.id}`}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script src="../scripts/toc-spy.ts"></script>